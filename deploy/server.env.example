# Production settings, installed to /etc/chatappfriends/server.env (root only).
# deploy.sh fills in the values marked as generated on the first run.
HOST=__TAILSCALE_IP__
PORT=8443
CLIENT_ORIGIN=https://__HOSTNAME__

JWT_SECRET=__JWT_SECRET__
INVITE_CODE=__INVITE_CODE__
MAX_USERS=20

MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=chatapp
MARIADB_PASSWORD=CHANGE_ME
MARIADB_DATABASE=chatapp

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=chatapp

UPLOAD_DIR=/var/lib/chatappfriends/uploads
MAX_IMAGE_BYTES=1073741824

MEDIA_LISTEN_IP=__TAILSCALE_IP__
MEDIA_PORT=40000
