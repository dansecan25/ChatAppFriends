# Local development settings. Copy to server/.env.
NODE_ENV=development
HOST=127.0.0.1
PORT=8443
CLIENT_ORIGIN=http://localhost:5173

# Generate with: openssl rand -hex 32
JWT_SECRET=
# Friends must enter this code to register.
INVITE_CODE=
MAX_USERS=20

MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=chatapp
MARIADB_PASSWORD=
MARIADB_DATABASE=chatapp

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=chatapp

UPLOAD_DIR=./uploads
MAX_IMAGE_BYTES=1073741824

# Voice traffic: one UDP and one TCP port on this address.
# Firefox ignores loopback for WebRTC, so use your LAN or Tailscale IP when testing voice in it.
MEDIA_LISTEN_IP=127.0.0.1
MEDIA_PORT=40000

# Leave both empty to serve plain HTTP in development.
TLS_CERT_PATH=
TLS_KEY_PATH=
